# ==================== AI 数据转换器 - 环境配置 ====================
# 复制此文件为 .env 并根据需要修改

# ==================== 应用基础配置 ====================
# 监听地址
APP_HOST=0.0.0.0
# 监听端口
APP_PORT=8000
# 调试模式（true/false）
DEBUG=false
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# ==================== AI 服务配置 ====================
# AI 提供商：minimax / openai / zhipu
AI_PROVIDER=minimax
# MiniMax API 密钥
MINIMAX_API_KEY=your_minimax_api_key_here
# MiniMax 基础地址
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# AI 请求超时（秒）
AI_TIMEOUT=120

# ==================== 文件配置 ====================
# 上传目录
UPLOAD_DIR=./uploads
# 最大文件大小（字节，默认 50MB）
MAX_FILE_SIZE=52428800
# 临时目录
TEMP_DIR=./tmp

# ==================== 安全配置 ====================
# CORS 允许的域名（逗号分隔，生产环境设为具体域名，如 http://example.com）
ALLOWED_ORIGINS=*
# 请求频率限制（每分钟最大请求数）
RATE_LIMIT_MAX=60
# 是否启用文件类型校验
FILE_TYPE_VALIDATION=true
# 是否启用 URL 域名校验
URL_DOMAIN_VALIDATION=true
# API 密钥（可选，设置后接口需要 Bearer Token 验证）
API_KEY=

# ==================== 缓存配置 ====================
# 缓存 TTL（秒）
CACHE_TTL=3600
# 最大缓存条目数
CACHE_MAX_SIZE=100